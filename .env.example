# Runtime
NODE_ENV=development
HYPERSTRIKE_ENV=local
LOG_LEVEL=info

# HyperCore API — HIP-4 market data, orders, positions, and settlement
HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_MAINNET_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET_API_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_MAINNET_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_TESTNET_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
HIP4_OUTCOME_META_TYPE=outcomeMeta
HIP4_MARKET_ALLOWLIST=
HIP4_QUOTE_TOKEN_ALLOWLIST=USDC,USDH
HIP4_FIXTURE_MODE=true

# Permissionless HIP-4 deployment. A validator-approved template and the
# protocol-required deployer stake must be confirmed before mainnet enablement.
HIP4_DEPLOYER_ADDRESS=
HIP4_TEMPLATE_ID=
HIP4_DEPLOYER_STAKE_HYPE=500000
HIP4_STAKE_LOCK_MONTHS=6
HIP4_INITIAL_OUTCOME_CAPACITY=100

# HIP-4 deployment and settlement hooks are intentionally unset until the
# active builder interface is documented and enabled for the target network.
HIP4_OPERATOR_ADDRESS=
HIP4_OPERATOR_PRIVATE_KEY=

# HyperEVM — optional HyperStrike app contracts, never HIP-4 market execution
HYPEREVM_MAINNET_RPC=https://rpc.hyperliquid.xyz/evm
HYPEREVM_TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
HYPEREVM_MAINNET_CHAIN_ID=999
HYPEREVM_TESTNET_CHAIN_ID=998
HYPEREVM_MAINNET_EXPLORER_URL=https://hyperevmscan.io
HYPEREVM_TESTNET_EXPLORER_URL=
HYPE_CORE_TRANSFER_ADDRESS=0x2222222222222222222222222222222222222222
HYPERSTRIKE_APP_CONTRACT_MAINNET=
HYPERSTRIKE_APP_CONTRACT_TESTNET=
HSX_TOKEN_MAINNET=0xab5dbc5a6070d066697d8e55471877ea4343ece3
HSX_TOKEN_TESTNET=
HSX_BURN_GATE_MAINNET=
HSX_BURN_GATE_TESTNET=
HSX_ISSUANCE_BURN_RAW=1000000000000000000000
# Participation burns are computed at runtime as 1% × normalized order value.
HSX_PARTICIPATION_BURN_RAW=dynamic

# Oracle service
ORACLE_POLICY_ID=launch-v1
ORACLE_OBSERVATION_INTERVAL_SECONDS=300
ORACLE_RESOLUTION_WINDOW_SECONDS=3600
ORACLE_MIN_VENUES=3
ORACLE_MAX_DIVERGENCE_BPS=1500
ORACLE_DATA_DIR=./services/oracle/.data
ORACLE_FIXTURE_MODE=true
ORACLE_REPORTER_PRIVATE_KEY=
FX_API_KEY=

# Venue credentials are configured only for licensed or explicitly permitted access.
BUFF163_API_BASE=
BUFF163_API_CREDENTIAL=
CSMONEY_API_BASE=
CSMONEY_API_CREDENTIAL=
SKINPORT_API_BASE=https://api.skinport.com/v1
SKINPORT_CLIENT_ID=
SKINPORT_CLIENT_SECRET=
CSFLOAT_API_BASE=
CSFLOAT_API_KEY=

# Application API and HIP-4 indexer
API_PORT=4000
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyperstrike
REDIS_URL=redis://localhost:6379/0
INDEXER_START_TIME=

# Browser application
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_HYPERLIQUID_NETWORK=mainnet
NEXT_PUBLIC_LIVE_TRADING=false
NEXT_PUBLIC_ENABLE_WEBGPU=false
NEXT_PUBLIC_HSX_TOKEN_ADDRESS=0xab5dbc5a6070d066697d8e55471877ea4343ece3
NEXT_PUBLIC_HSX_BURN_GATE_ADDRESS=
VITE_HSX_BURN_GATE_ADDRESS=

# Burn gate deployment/admin scripts
PRIVATE_KEY=
GATE_OWNER=
GATE_ADDRESS=
ISSUANCE_BURN_HSX=1000

# Embedded wallet — required only when live trading is enabled
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# Monitoring
SENTRY_DSN_WEB=
SENTRY_DSN_API=
SENTRY_DSN_ORACLE=
GRAFANA_CLOUD_API_KEY=
