# Backend / independent services. Node >=22.13. Never expose secrets with VITE_.
HOST=127.0.0.1
PORT=8787
# Optional absolute path; by default every service uses <repo>/var/hyperstrike.sqlite.
# HS_DATABASE_PATH=/absolute/path/hyperstrike.sqlite
# Public Skinport indicative display feed; no API key. Never used for settlement.
HS_INDICATIVE_ENABLED=true
HS_RPC_URL=https://rpc.hyperliquid.xyz/evm
# All values below must be reviewed deployments, never demo fixtures.
HS_ADMIN_MULTISIG=
HS_CONFIG_TIMELOCK=
HS_TREASURY=
HS_COLLATERAL_ADDRESS=
HS_HSX_TWAP_ADDRESS=
HS_HSX_REFERENCE_ADDRESS=
HS_ORACLE_SIGNERS=
HS_REVIEW_REPORT=
HS_PILOT_CAP=10000
HS_FACTORY_ADDRESS=
HS_INDEX_ORACLE_ADDRESS=
HS_SETTLEMENT_ADDRESS=
HS_MINTER_ADDRESS=
HS_STRIKE_ADDRESS=
HS_FEE_VAULT_ADDRESS=
HS_DEPLOYMENT_BLOCK=
HS_CONFIRMATIONS=20
# HS_SIGNER_KEY: inject exactly one isolated signer key per signer host.
# HS_DEPLOYER_KEY: local secret manager only; not needed for dev/build/tests.

# Public frontend addresses. Blank values keep native value flows unavailable.
VITE_NATIVE_FACTORY_ADDRESS=
VITE_COLLATERAL_ADDRESS=
VITE_STRIKE_MINTER_ADDRESS=
VITE_STRIKE_ADDRESS=
VITE_FEE_VAULT_ADDRESS=
