# Backend / independent services. Node >=22.13. Never expose secrets with VITE_.
HOST=127.0.0.1
PORT=8787
# Optional absolute path; by default every service uses <repo>/var/hyperstrike.sqlite.
# HS_DATABASE_PATH=/absolute/path/hyperstrike.sqlite
# Public Skinport indicative display feed; no API key. Never used for settlement.
HS_INDICATIVE_ENABLED=true
HS_RPC_URL=https://rpc.hyperliquid.xyz/evm
# All values below must be reviewed deployments, never demo fixtures.
# Admin multisig (contract account, e.g. a Safe) and treasury: required, must already be deployed.
HS_ADMIN_MULTISIG=
HS_TREASURY=
# Optional. Leave blank and the deployment creates ConfigTimelock (48h, multisig proposer/executor, no admin).
HS_CONFIG_TIMELOCK=
# Sole market collateral. Native Circle USDC on HyperEVM is 0xb88339CB7199b77E23DB6E890353E22632Ba630f
# (6 decimals). There is no default: set it explicitly and record its review in HS_REVIEW_REPORT.
HS_COLLATERAL_ADDRESS=
# Three distinct oracle signer addresses, comma separated (2-of-3 quorum).
HS_ORACLE_SIGNERS=
# Committee-approved genesis baskets {methodologyHash, baskets:[{ticker,indexId,versionId,compositionRoot}]}.
# Defaults to <repo>/config/index-genesis.json. Genesis versions go live in the IndexRegistry constructor.
# HS_GENESIS_CONFIG=/absolute/path/index-genesis.json
HS_REVIEW_REPORT=
HS_PILOT_CAP=10000
# Emitted by `pnpm native:deploy --broadcast` (also stored in the deployment manifest's `env`).
# HsxV3Twap (HSX/WHYPE pool 30-min TWAP x HyperCore HYPE oracle) and HsxSignedReference are deployed
# by the script; they are outputs, not inputs.
HS_FACTORY_ADDRESS=
HS_INDEX_ORACLE_ADDRESS=
HS_INDEX_REGISTRY_ADDRESS=
HS_SIGNER_REGISTRY_ADDRESS=
HS_SETTLEMENT_ADDRESS=
HS_MINTER_ADDRESS=
HS_STRIKE_ADDRESS=
HS_FEE_VAULT_ADDRESS=
HS_HSX_TWAP_ADDRESS=
HS_HSX_REFERENCE_ADDRESS=
HS_HSX_PRICE_ORACLE_ADDRESS=
HS_DEPLOYMENT_BLOCK=
HS_CONFIRMATIONS=20
# `pnpm native:deploy --rehearse` runs the identical deployment on a local anvil fork: no real funds,
# no review report needed; unset values above are replaced by labelled throwaway accounts.
# HS_SIGNER_KEY: inject exactly one isolated signer key per signer host.
# HS_DEPLOYER_KEY: local secret manager only; not needed for dev/build/tests.

# Public frontend addresses. Blank values keep native value flows unavailable.
# Static is the default. Set api only with a deployed API + /v1 reverse proxy.
VITE_DATA_MODE=static
VITE_NATIVE_FACTORY_ADDRESS=
VITE_COLLATERAL_ADDRESS=
VITE_STRIKE_MINTER_ADDRESS=
VITE_STRIKE_ADDRESS=
VITE_FEE_VAULT_ADDRESS=
